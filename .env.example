# ==============================================================================
# REQUIRED FOR TELEGRAM BOT (Only value you need to provide)
# Get this from @BotFather on Telegram (/newbot -> copy the HTTP API token)
# ==============================================================================
TELEGRAM_BOT_TOKEN=""

# ==============================================================================
# ADMIN WEB PANEL (Required to access Telegram Bot settings)
# ==============================================================================
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-this-to-a-long-random-password"

# ==============================================================================
# OPTIONAL SETTINGS (Sensible defaults work out of the box — no changes needed)
# ==============================================================================
# Keep default for 50 MB Telegram cloud limit.
# Only change if self-hosting a local telegram-bot-api server (2000 MB limit).
TELEGRAM_API_ROOT="https://api.telegram.org"

# Max parallel zero-disk media streams
BOT_CONCURRENCY="8"

# Web control console & stream tester port
PORT="3000"